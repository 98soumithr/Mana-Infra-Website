<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Remove .html extension from URLs (internal rewrite only)
  # If the request doesn't match a file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # And doesn't already end with .html
  RewriteCond %{REQUEST_URI} !\.html$
  # Then rewrite to add .html
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
